DirectoryIndex index.html
RewriteEngine On
RewriteRule ^isola\.html$ index.html [END]

<IfModule mod_headers.c>
  <Files "index.html">
    Header always set Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"
    Header always set CDN-Cache-Control "no-store"
  </Files>
</IfModule>
