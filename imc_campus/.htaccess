RewriteEngine On
RewriteCond %{REQUEST_URI} ^/imc_campus/(index\.html)?$
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^(index\.html)?$ https://www.italianmastersclub.it/imc_campus/?mobile=full [R=302,L]

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/imc_campus/(index\.html)?$#">
    Header always set Cache-Control "no-store, max-age=0, must-revalidate"
    Header always set CDN-Cache-Control "no-store"
  </If>
</IfModule>
