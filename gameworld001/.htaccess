RewriteEngine On
RewriteBase /gameworld001/

# GW001 must always serve the current application state.
FileETag None

<IfModule mod_headers.c>
  Header unset ETag
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

# Serve real frontend assets directly; route every page URL through the GW001 shell.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [L]
