<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(gw00[1-9]|gw01[01])/?$ world-route.php?route_world=$1 [END,QSA,NC]
RewriteRule ^(gw00[1-9]|gw01[01])/competitions(?:/([a-z0-9-]+))?/?$ world-route.php?route_world=$1&route_competitions=1 [END,QSA,NC]
RewriteRule ^(gw00[1-9]|gw01[01])/competizioni/?$ /nexus/$1/competitions/ [R=302,L,NC]
</IfModule>
