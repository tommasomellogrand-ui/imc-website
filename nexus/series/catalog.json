  "episodes": [
    {
      "id": "prologo-atletico",
      "number": "00",
      "label": "PROLOGO · PRESENTAZIONE",
      "status": "published",
      "publishedAt": "2026-10-20T00:00:00Z",
      "category": "Dietro le quinte",
      "clubs": [
        "139"
      ],
      "title": "Paco ha aperto il gruppo.",
      "description": "Nove personaggi, una sola squadra. La famiglia rojiblanca si presenta: e qualcuno ha già perso il controllo della chat.",
      "note": "Episodio introduttivo di fantasia: presenta il cast e non racconta operazioni di mercato o partite reali.",
      "messages": [
        {
          "character": "paco",
          "text": "Ho aperto il gruppo. Le chiavi dello stadio le ho io. Quelle della chat, purtroppo, le avete tutti."
        },
        {
          "character": "tom",
          "text": "Perfetto, Paco. Partiamo da una cosa semplice: qui parliamo dell’Atlético."
        },
        {
          "character": "cerezo",
          "text": "Ottimo titolo. Ma per la prima puntata voglio una presentazione da cinema."
        },
        {
          "character": "gil",
          "text": "Prima della presentazione, il preventivo."
        },
        {
          "character": "alemany",
          "text": "Intanto io ascolto. Quando c’è qualcosa da firmare, chiamatemi."
        },
        {
          "character": "futre",
          "text": "Basta che ogni tanto qualcuno salti l’uomo. Anche in questa chat."
        },
        {
          "character": "sabina",
          "text": "Madrid ha già abbastanza notti insonni. Ci mancava questo gruppo."
        },
        {
          "character": "ranieri",
          "text": "Un messaggio alla volta, ragazzi. Cominciamo con ordine."
        },
        {
          "character": "fullana",
          "text": "Una domanda: quello che scrivete qui è tutto dichiarabile?"
        },
        {
          "character": "tom",
          "text": "Paco, chi gli ha dato il link?"
        },
        {
          "character": "paco",
          "text": "Mister, mi avete detto di aprire. Io apro."
        }
      ]
    }
  ]
}
